# Use Netlify UI > Environment variables (Functions scope), NEVER commit keys
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=YOUR_MODEL_NAME
AI_API_KEY=REPLACE_WITH_NEW_ROTATED_PRIVATE_KEY
AI_ACCESS_TOKEN=YOUR_OWN_NEW_PRIVATE_PLAYER_ACCESS_CODE
# Only for explicitly opted-in public mode; unlimited public paid access is risky
AI_PUBLIC_MODE=false
# Optional if your model requires it
AI_TOKEN_PARAM=max_tokens
